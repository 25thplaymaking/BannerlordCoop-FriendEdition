[Unit]
Description=Cloudflare Tunnel for the Calradia Co-op campaign portal
Wants=network-online.target calradia-coop-portal.service
After=network-online.target calradia-coop-portal.service

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel --config %h/bannerlord-coop/portal/cloudflared.yml run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
