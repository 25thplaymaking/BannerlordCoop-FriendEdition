<Application x:Class="CoopLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!-- ══ Calradia palette ══ -->
        <Color x:Key="InkColor">#FF14100B</Color>
        <Color x:Key="LeatherColor">#FF241B12</Color>
        <Color x:Key="LeatherLightColor">#FF33261A</Color>
        <Color x:Key="ParchmentColor">#FFE8DCC0</Color>
        <Color x:Key="GoldColor">#FFC9A24B</Color>
        <Color x:Key="GoldBrightColor">#FFE7C56A</Color>
        <Color x:Key="BloodColor">#FF7A1F16</Color>
        <Color x:Key="BloodBrightColor">#FF9E2A1E</Color>
        <Color x:Key="SteelColor">#FF6E7B83</Color>

        <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="Leather" Color="{StaticResource LeatherColor}" />
        <SolidColorBrush x:Key="LeatherLight" Color="{StaticResource LeatherLightColor}" />
        <SolidColorBrush x:Key="Parchment" Color="{StaticResource ParchmentColor}" />
        <SolidColorBrush x:Key="Gold" Color="{StaticResource GoldColor}" />
        <SolidColorBrush x:Key="GoldBright" Color="{StaticResource GoldBrightColor}" />
        <SolidColorBrush x:Key="Blood" Color="{StaticResource BloodColor}" />
        <SolidColorBrush x:Key="BloodBright" Color="{StaticResource BloodBrightColor}" />
        <SolidColorBrush x:Key="Steel" Color="{StaticResource SteelColor}" />

        <FontFamily x:Key="Display">Constantia</FontFamily>
        <FontFamily x:Key="Dispatch">Consolas</FontFamily>
        <FontFamily x:Key="Utility">Segoe UI</FontFamily>

        <!-- ══ Window control glyph buttons (minimize / close) ══ -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Steel}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontFamily" Value="{StaticResource Utility}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource LeatherLight}" />
                                <Setter Property="Foreground" Value="{StaticResource GoldBright}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Secondary action: a quiet bordered button (e.g. gather logs) ══ -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Steel}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource Dispatch}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="#55C9A24B" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource LeatherLight}" />
                                <Setter Property="Foreground" Value="{StaticResource GoldBright}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Primary call-to-action: the war button ══ -->
        <Style x:Key="WarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Parchment}" />
            <Setter Property="FontFamily" Value="{StaticResource Display}" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Gold outer frame -->
                            <Border x:Name="frame" CornerRadius="1" Background="{StaticResource Gold}" />
                            <!-- Blood field, inset 2px so the gold reads as a forged border -->
                            <Border x:Name="field" Margin="2" CornerRadius="0"
                                    Background="{StaticResource Blood}">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="glow" Color="{StaticResource GoldColor}"
                                                      BlurRadius="0" ShadowDepth="0" Opacity="0" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="field" Property="Background" Value="{StaticResource BloodBright}" />
                                <Setter TargetName="frame" Property="Background" Value="{StaticResource GoldBright}" />
                                <Setter Property="Foreground" Value="{StaticResource GoldBright}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow"
                                                Storyboard.TargetProperty="BlurRadius"
                                                To="18" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="glow"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.85" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow"
                                                Storyboard.TargetProperty="BlurRadius"
                                                To="0" Duration="0:0:0.25" />
                                            <DoubleAnimation Storyboard.TargetName="glow"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0" Duration="0:0:0.25" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="field" Property="Background" Value="{StaticResource LeatherLight}" />
                                <Setter TargetName="frame" Property="Background" Value="{StaticResource Leather}" />
                                <Setter Property="Foreground" Value="{StaticResource Steel}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Top navigation tab (MUSTER / CHRONICLE / OPTIONS): etched label, gold underline ══ -->
        <Style x:Key="NavTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Steel}" />
            <Setter Property="FontFamily" Value="{StaticResource Display}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="3" />
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0" Margin="4,0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Rectangle x:Name="underline" Grid.Row="1" Height="2" Margin="2,0"
                                       Fill="{StaticResource Gold}" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource GoldBright}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Parchment}" />
                                <Setter TargetName="underline" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Options: stable/nightly channel toggle — steel STABLE flips to gold NIGHTLY ══ -->
        <Style x:Key="ChannelToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Steel}" />
            <Setter Property="FontFamily" Value="{StaticResource Dispatch}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="110" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" Background="{StaticResource Leather}"
                                BorderBrush="#55C9A24B" BorderThickness="1">
                            <TextBlock x:Name="label" Text="STABLE"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="label" Property="Text" Value="NIGHTLY" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource Gold}" />
                                <Setter Property="Foreground" Value="{StaticResource GoldBright}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource LeatherLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Options: themed checkbox — leather box, gold check ══ -->
        <Style x:Key="WarCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Parchment}" />
            <Setter Property="FontFamily" Value="{StaticResource Utility}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="16" Height="16" Margin="0,0,9,0"
                                    VerticalAlignment="Center" Background="{StaticResource Leather}"
                                    BorderBrush="#66C9A24B" BorderThickness="1">
                                <TextBlock x:Name="mark" Text="&#x2713;" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource GoldBright}" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource LeatherLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Section header used across Chronicle and Options panels ══ -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Gold}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- ══ Option row label ══ -->
        <Style x:Key="OptionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Dispatch}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Steel}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Application.Resources>
</Application>
