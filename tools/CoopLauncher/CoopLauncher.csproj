<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CalradiaCoop</AssemblyName>
    <RootNamespace>CoopLauncher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Frontir.ico</ApplicationIcon>

    <!-- Distributable to friends: one self-contained .exe, no .NET install required. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <Version>1.0.0</Version>
    <Product>Calradia Co-op Launcher</Product>
    <Company>Frontir</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI for the opt-in remembered join password (Options tab). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ships beside the .exe; edited without a rebuild so the group can retune the server target. -->
    <None Update="launcher-config.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Frontir shield crest; embedded so the borderless window's taskbar/Alt-Tab icon resolves at runtime. -->
    <Resource Include="Frontir.ico" />
  </ItemGroup>

</Project>
