<Window x:Class="CoopLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Europe 1100 Co-op" Height="800" Width="1280" MinHeight="700" MinWidth="1100"
        Icon="Frontir.ico"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Ink}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Utility}" TextOptions.TextFormattingMode="Ideal">

    <!-- Borderless but resizable: WindowChrome supplies the resize borders; the title strip
         keeps its own DragMove. CaptionHeight=0 so our buttons/tabs receive their clicks. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Thin campaign-map progress rail: gold advance over a leather track. -->
        <Style x:Key="RailBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Gold}" />
            <Setter Property="Background" Value="{StaticResource LeatherLight}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}">
                            <Grid>
                                <Rectangle x:Name="PART_Track" />
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                           Fill="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WarComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Parchment}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource LeatherLight}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource GoldBright}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WarComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Parchment}" />
            <Setter Property="Background" Value="{StaticResource Leather}" />
            <Setter Property="BorderBrush" Value="#66C9A24B" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource WarComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                            <ContentPresenter Margin="9,0,30,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <ToggleButton Background="Transparent" BorderThickness="0"
                                          HorizontalAlignment="Right" Width="30" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <TextBlock Text="&#x25BE;" Foreground="{StaticResource Gold}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="320" Background="{StaticResource Ink}"
                                        BorderBrush="{StaticResource Gold}" BorderThickness="1">
                                    <ScrollViewer><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Double frame: gold hairline outside, ink field inside — a forged plaque grown to a hall. -->
    <Border Background="{StaticResource Ink}" BorderBrush="{StaticResource Gold}" BorderThickness="1.5">
        <Border BorderBrush="#33C9A24B" BorderThickness="1" Margin="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ══ Title strip: wordmark │ nav tabs │ window controls ══ -->
                <Grid x:Name="TitleBar" Grid.Row="0" Background="#00000000">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="14,0,0,0" ToolTip="Europe 1100 Co-op">
                        <!-- The Concord Standard: two shields joined by a shared road. Original launcher mark. -->
                        <Viewbox Width="26" Height="26" Margin="0,0,8,0">
                            <Grid Width="32" Height="32">
                                <Path Data="M3,5 L15,2 L15,25 L9,30 L3,25 Z" Fill="#FF8C1F17"
                                      Stroke="{StaticResource Gold}" StrokeThickness="1.6" />
                                <Path Data="M29,5 L17,2 L17,25 L23,30 L29,25 Z" Fill="#FF1E3A6B"
                                      Stroke="{StaticResource Gold}" StrokeThickness="1.6" />
                                <Path Data="M12,7 L20,25" Stroke="{StaticResource GoldBright}" StrokeThickness="2" />
                                <Path Data="M20,7 L12,25" Stroke="{StaticResource GoldBright}" StrokeThickness="2" />
                            </Grid>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="EUROPE 1100" FontFamily="{StaticResource Display}"
                                       FontSize="13" FontWeight="Bold" Foreground="{StaticResource Gold}" />
                            <TextBlock Text="ANNO MCI &#183; CAMPAIGN LAUNCHER" FontFamily="{StaticResource Dispatch}"
                                       FontSize="7.5" Foreground="{StaticResource Steel}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Stretch">
                        <RadioButton x:Name="MusterTab" Style="{StaticResource NavTab}" Content="MUSTER"
                                     GroupName="Nav" IsChecked="True" />
                        <RadioButton x:Name="ChronicleTab" Style="{StaticResource NavTab}" Content="CHRONICLE"
                                     GroupName="Nav" />
                        <RadioButton x:Name="RosterTab" Style="{StaticResource NavTab}" Content="ROSTER"
                                     GroupName="Nav" />
                        <RadioButton x:Name="OptionsTab" Style="{StaticResource NavTab}" Content="OPTIONS"
                                     GroupName="Nav" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="MinButton" Style="{StaticResource ChromeButton}" Content="&#x2013;"
                                ToolTip="Minimize" />
                        <Button x:Name="CloseButton" Style="{StaticResource ChromeButton}" Content="&#x2715;"
                                ToolTip="Close" />
                    </StackPanel>
                </Grid>

                <!-- ══ Body: full-bleed war-camp backdrop with the section panels above it ══ -->
                <Grid Grid.Row="1">

                    <!-- ── Backdrop: dusk sky → mountains → war camp. All original vector art. ── -->
                    <Image Source="pack://application:,,,/Assets/calradia-muster-backdrop.png"
                           Stretch="UniformToFill" Opacity="0.9" IsHitTestVisible="False" />
                    <Rectangle IsHitTestVisible="False" Opacity="0.48">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF07090C" Offset="0" />
                                <GradientStop Color="#990E1218" Offset="0.48" />
                                <GradientStop Color="#D90D1117" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Grid IsHitTestVisible="False" Opacity="0.28">
                        <!-- Original vector weather and depth remain as a restrained overlay. -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF0D1117" Offset="0" />
                                    <GradientStop Color="#FF161E29" Offset="0.45" />
                                    <GradientStop Color="#FF2B3A4E" Offset="0.78" />
                                    <GradientStop Color="#FF1B2431" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Horizon glow behind the far ridge -->
                        <Ellipse Width="900" Height="260" VerticalAlignment="Bottom" Margin="0,0,0,150">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#33C9A24B" Offset="0" />
                                    <GradientStop Color="#00C9A24B" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- Far mountain ridge -->
                        <Polygon Points="0,190 140,120 300,175 470,95 650,170 830,110 1000,180 1180,125 1400,185 1400,400 0,400"
                                 Fill="#FF090C11" Opacity="0.9" VerticalAlignment="Bottom" Height="400"
                                 Stretch="Fill" />
                        <!-- Near ridge -->
                        <Polygon Points="0,120 220,55 420,115 640,40 900,110 1120,60 1400,120 1400,300 0,300"
                                 Fill="#FF06080B" VerticalAlignment="Bottom" Height="300" Stretch="Fill" />
                        <!-- 1100 skyline: a stone keep, a round tower, an abbey and a crenellated
                             curtain wall on the ground band, with torchlight at the gates. Same
                             1400x190 band and silhouette tones the war camp used. -->
                        <Canvas VerticalAlignment="Bottom" Height="190" Opacity="0.85">
                            <!-- Stone keep with its merlons and a taller corner tower -->
                            <Rectangle Canvas.Left="100" Canvas.Top="102" Width="148" Height="88" Fill="#FF141C26" />
                            <Rectangle Canvas.Left="100" Canvas.Top="90" Width="17" Height="14" Fill="#FF141C26" />
                            <Rectangle Canvas.Left="126" Canvas.Top="90" Width="17" Height="14" Fill="#FF141C26" />
                            <Rectangle Canvas.Left="152" Canvas.Top="90" Width="17" Height="14" Fill="#FF141C26" />
                            <Rectangle Canvas.Left="178" Canvas.Top="90" Width="17" Height="14" Fill="#FF141C26" />
                            <Rectangle Canvas.Left="204" Canvas.Top="90" Width="17" Height="14" Fill="#FF141C26" />
                            <Rectangle Canvas.Left="230" Canvas.Top="90" Width="17" Height="14" Fill="#FF141C26" />
                            <Rectangle Canvas.Left="226" Canvas.Top="64" Width="38" Height="126" Fill="#FF0F151D" />
                            <Rectangle Canvas.Left="226" Canvas.Top="52" Width="15" Height="14" Fill="#FF0F151D" />
                            <Rectangle Canvas.Left="249" Canvas.Top="52" Width="15" Height="14" Fill="#FF0F151D" />
                            <!-- Gate arch -->
                            <Path Canvas.Left="150" Canvas.Top="150" Fill="#FF090C11"
                                  Data="M0,40 L0,14 A14,14 0 0 1 28,14 L28,40 Z" />

                            <!-- Round tower under a conical roof -->
                            <Rectangle Canvas.Left="342" Canvas.Top="112" Width="46" Height="78" Fill="#FF121924" />
                            <Polygon Points="338,113 365,68 392,113" Fill="#FF0F151D" />

                            <!-- Abbey: nave, bell tower, spire and cross -->
                            <Rectangle Canvas.Left="880" Canvas.Top="132" Width="118" Height="58" Fill="#FF141C26" />
                            <Rectangle Canvas.Left="998" Canvas.Top="88" Width="36" Height="102" Fill="#FF0F151D" />
                            <Polygon Points="996,89 1016,42 1036,89" Fill="#FF0F151D" />
                            <Rectangle Canvas.Left="1015" Canvas.Top="26" Width="3" Height="17" Fill="#FF1B2431" />
                            <Rectangle Canvas.Left="1009" Canvas.Top="31" Width="15" Height="3" Fill="#FF1B2431" />
                            <!-- Lancet windows -->
                            <Path Canvas.Left="906" Canvas.Top="150" Fill="#66E3CE8B"
                                  Data="M0,26 L0,8 A5,5 0 0 1 10,8 L10,26 Z" />
                            <Path Canvas.Left="944" Canvas.Top="150" Fill="#66E3CE8B"
                                  Data="M0,26 L0,8 A5,5 0 0 1 10,8 L10,26 Z" />

                            <!-- Crenellated curtain wall -->
                            <Rectangle Canvas.Left="1118" Canvas.Top="148" Width="156" Height="42" Fill="#FF121924" />
                            <Rectangle Canvas.Left="1118" Canvas.Top="136" Width="16" Height="14" Fill="#FF121924" />
                            <Rectangle Canvas.Left="1146" Canvas.Top="136" Width="16" Height="14" Fill="#FF121924" />
                            <Rectangle Canvas.Left="1174" Canvas.Top="136" Width="16" Height="14" Fill="#FF121924" />
                            <Rectangle Canvas.Left="1202" Canvas.Top="136" Width="16" Height="14" Fill="#FF121924" />
                            <Rectangle Canvas.Left="1230" Canvas.Top="136" Width="16" Height="14" Fill="#FF121924" />
                            <Rectangle Canvas.Left="1258" Canvas.Top="136" Width="16" Height="14" Fill="#FF121924" />

                            <!-- Torchlight at the keep gate and the wall postern (static glints;
                                 the drifting embers are animated in code) -->
                            <Ellipse Canvas.Left="262" Canvas.Top="168" Width="5" Height="5" Fill="#CCE3CE8B" />
                            <Ellipse Canvas.Left="256" Canvas.Top="176" Width="8" Height="6" Fill="#88A8241C" />
                            <Ellipse Canvas.Left="1104" Canvas.Top="170" Width="5" Height="5" Fill="#CCE3CE8B" />
                            <Ellipse Canvas.Left="1098" Canvas.Top="178" Width="8" Height="6" Fill="#88A8241C" />
                        </Canvas>
                        <!-- Drifting embers (populated in code; skipped when animations are disabled) -->
                        <Canvas x:Name="EmberCanvas" />
                    </Grid>

                    <!-- ── The hanging war banner: the signature, larger, at the hall's left ── -->
                    <Canvas x:Name="BannerCanvas" Width="220" HorizontalAlignment="Left"
                            Margin="34,0,0,0" RenderTransformOrigin="0.5,0" IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <ScaleTransform x:Name="BannerScale" ScaleY="1" />
                        </Canvas.RenderTransform>

                        <!-- Crossbar the banner hangs from -->
                        <Rectangle Canvas.Left="30" Canvas.Top="16" Width="160" Height="7"
                                   Fill="{StaticResource Gold}" />
                        <Ellipse Canvas.Left="32" Canvas.Top="13" Width="12" Height="12" Fill="{StaticResource GoldBright}" />
                        <Ellipse Canvas.Left="176" Canvas.Top="13" Width="12" Height="12" Fill="{StaticResource GoldBright}" />

                        <!-- Cloth: swallowtail pennant -->
                        <Path x:Name="BannerCloth" Canvas.Left="42" Canvas.Top="23"
                              Stroke="{StaticResource Gold}" StrokeThickness="1.5"
                              Data="M0,0 L136,0 L136,420 L68,382 L0,420 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="{StaticResource BloodColor}" Offset="0" />
                                    <GradientStop Color="#FF3A130E" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- Inner hairline inset -->
                        <Path Canvas.Left="53" Canvas.Top="34" Stroke="#66E7C56A" StrokeThickness="1"
                              Data="M0,0 L114,0 L114,364 L57,332 L0,364 Z" />

                        <!-- Standard sigil: the century the conversion is set in.
                             Gold when the host is up, steel when it is down. -->
                        <TextBlock x:Name="Sigil" Canvas.Left="60" Canvas.Top="168" Width="100"
                                   TextAlignment="Center" FontFamily="{StaticResource Display}" FontSize="54"
                                   FontWeight="Bold" Text="XI" Foreground="{StaticResource Steel}" />

                        <!-- Muster year etched toward the tail -->
                        <TextBlock Canvas.Left="42" Canvas.Top="300" Width="136" TextAlignment="Center"
                                   FontFamily="{StaticResource Display}" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource Parchment}" Text="EUROPA" Opacity="0.7" />
                    </Canvas>

                    <!-- ── Readability scrim behind the content column ── -->
                    <Border HorizontalAlignment="Stretch" Margin="290,0,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#000D1117" Offset="0" />
                                <GradientStop Color="#B30D1117" Offset="0.18" />
                                <GradientStop Color="#D90D1117" Offset="0.6" />
                                <GradientStop Color="#B30D1117" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- ══ MUSTER ══ -->
                    <Grid x:Name="MusterPanel" Margin="330,34,60,34" MaxWidth="720"
                          HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="P R I V A T E   M U S T E R   &#183;   A N N O   M C I"
                                   FontSize="12" Foreground="{StaticResource Steel}" />

                        <TextBlock x:Name="TitleText" Grid.Row="1" Text="Europe 1100 Co-op"
                                   FontFamily="{StaticResource Display}" FontSize="52" FontWeight="Bold"
                                   Foreground="{StaticResource Parchment}" TextWrapping="Wrap"
                                   Margin="0,4,0,0" LineHeight="54" LineStackingStrategy="BlockLineHeight" />

                        <Rectangle Grid.Row="2" Height="1" Width="170" HorizontalAlignment="Left"
                                   Fill="{StaticResource Gold}" Opacity="0.55" Margin="0,14,0,0" />

                        <!-- Field dispatch: live host status in a monospaced readout -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock x:Name="StatusGlyph" Text="&#x25CF;" FontFamily="{StaticResource Dispatch}"
                                       FontSize="14" Foreground="{StaticResource Steel}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Margin="9,0,0,0" VerticalAlignment="Center"
                                       FontFamily="{StaticResource Dispatch}" FontSize="14"
                                       Foreground="{StaticResource Steel}" Text="Scouting the host…" />
                        </StackPanel>

                        <!-- Armory ledger: three independent receipts; never collapse them into one build label. -->
                        <Border Grid.Row="4" Margin="0,18,0,14" Padding="16,12"
                                VerticalAlignment="Center" Background="#66170F0C"
                                BorderBrush="#55C9A24B" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ArmoryHeadline" Grid.Row="0" Grid.ColumnSpan="2"
                                           FontFamily="{StaticResource Display}" FontSize="14"
                                           FontWeight="Bold" Foreground="{StaticResource Gold}"
                                           Text="CHECKING THE ARMORY" />
                                <TextBlock x:Name="ArmoryDetail" Grid.Row="1" Grid.ColumnSpan="2"
                                           Margin="0,3,0,0" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource Steel}"
                                           Text="Reading all three royal update scrolls." />

                                <TextBlock Grid.Row="3" Text="LAUNCHER" FontFamily="{StaticResource Dispatch}"
                                           FontSize="11.5" Foreground="{StaticResource Steel}" />
                                <TextBlock x:Name="LauncherUpdateValue" Grid.Row="3" Grid.Column="1"
                                           FontFamily="{StaticResource Dispatch}" FontSize="11.5"
                                           Foreground="{StaticResource Steel}" Text="Checking…"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="4" Text="MOD SUITE" FontFamily="{StaticResource Dispatch}"
                                           FontSize="11.5" Foreground="{StaticResource Steel}" />
                                <TextBlock x:Name="SuiteUpdateValue" Grid.Row="4" Grid.Column="1"
                                           FontFamily="{StaticResource Dispatch}" FontSize="11.5"
                                           Foreground="{StaticResource Steel}" Text="Checking…"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="5" Text="CO-OP CLIENT" FontFamily="{StaticResource Dispatch}"
                                           FontSize="11.5" Foreground="{StaticResource Steel}" />
                                <TextBlock x:Name="ClientUpdateValue" Grid.Row="5" Grid.Column="1"
                                           FontFamily="{StaticResource Dispatch}" FontSize="11.5"
                                           Foreground="{StaticResource Steel}" Text="Checking…"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <!-- Private host credential: never persisted unless the member opts in (Options). -->
                        <Grid Grid.Row="5" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="JOIN PASSWORD" VerticalAlignment="Center"
                                       FontFamily="{StaticResource Dispatch}" FontSize="12"
                                       Foreground="{StaticResource Steel}" />
                            <Border Grid.Column="1" Height="38" Background="{StaticResource Leather}"
                                    BorderBrush="#66C9A24B" BorderThickness="1" Padding="9,4">
                                <PasswordBox x:Name="ServerPasswordBox" Background="Transparent"
                                             BorderThickness="0" Foreground="{StaticResource Parchment}"
                                             CaretBrush="{StaticResource GoldBright}" FontSize="15"
                                             PasswordChar="&#x25CF;" ToolTip="Enter the host password"
                                             VerticalContentAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- Primary action -->
                        <Button x:Name="JoinButton" Grid.Row="6" Height="62" Style="{StaticResource WarButton}"
                                Content="MARCH TO WAR" IsEnabled="False" />

                        <!-- Update rail -->
                        <StackPanel Grid.Row="7" Margin="0,16,0,0">
                            <ProgressBar x:Name="UpdateBar" Style="{StaticResource RailBar}" Value="0"
                                         Visibility="Collapsed" />
                            <TextBlock x:Name="UpdateText" Margin="0,9,0,0" FontFamily="{StaticResource Dispatch}"
                                       FontSize="11.5" Foreground="{StaticResource Steel}" TextTrimming="CharacterEllipsis"
                                       Text="">
                                <!-- Reveal the full dispatch line (trimmed error/version detail) on hover;
                                     suppress the tooltip while the line is empty so no blank box appears. -->
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="ToolTip" Value="{x:Null}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- ══ CHRONICLE ══ -->
                    <Grid x:Name="ChroniclePanel" Margin="330,34,60,34" MaxWidth="760"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="T H E   C H R O N I C L E"
                                       FontSize="12" Foreground="{StaticResource Steel}" />
                            <TextBlock Text="Campaign Dispatches"
                                       FontFamily="{StaticResource Display}" FontSize="34" FontWeight="Bold"
                                       Foreground="{StaticResource Parchment}" Margin="0,2,0,0" />
                            <Rectangle Height="1" Width="170" HorizontalAlignment="Left"
                                       Fill="{StaticResource Gold}" Opacity="0.55" Margin="0,10,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="ChronicleEmptyText"
                                           FontFamily="{StaticResource Dispatch}" FontSize="12"
                                           Foreground="{StaticResource Steel}"
                                           Text="The chronicle is being fetched from the royal archives…"
                                           Margin="0,6,0,0" />
                                <ItemsControl x:Name="ChronicleList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,12,12" Padding="16,12"
                                                    Background="#66170F0C"
                                                    BorderBrush="#44C9A24B" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontFamily="{StaticResource Display}"
                                                                   FontSize="16" FontWeight="Bold"
                                                                   Foreground="{StaticResource Gold}"
                                                                   TextWrapping="Wrap" Margin="0,0,110,0" />
                                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                   FontFamily="{StaticResource Dispatch}" FontSize="10.5"
                                                                   Foreground="{StaticResource Steel}">
                                                            <Run Text="{Binding Date}" />
                                                            <Run Text="  " /><Run Text="{Binding Version}" />
                                                        </TextBlock>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Highlights}" Margin="0,6,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="&#x2694;" FontSize="10"
                                                                               Foreground="{StaticResource Steel}"
                                                                               Margin="0,2,8,0" VerticalAlignment="Top" />
                                                                    <TextBlock Text="{Binding}" FontSize="12.5"
                                                                               Foreground="{StaticResource Parchment}"
                                                                               TextWrapping="Wrap" MaxWidth="620" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ══ LORDS / AUTHORITATIVE CAMPAIGN LEDGER ══ -->
                    <Grid x:Name="RosterPanel" Margin="330,34,44,34" MaxWidth="900"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="T H E   C A M P A I G N   L E D G E R"
                                       FontSize="12" Foreground="{StaticResource Steel}" />
                            <TextBlock Text="Lords of Europe"
                                       FontFamily="{StaticResource Display}" FontSize="34" FontWeight="Bold"
                                       Foreground="{StaticResource Parchment}" Margin="0,2,0,0" />
                            <Rectangle Height="1" Width="170" HorizontalAlignment="Left"
                                       Fill="{StaticResource Gold}" Opacity="0.55" Margin="0,10,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="RosterSummaryText" Grid.Row="1" Margin="0,0,0,10"
                                   FontFamily="{StaticResource Dispatch}" FontSize="11.5"
                                   Foreground="{StaticResource Steel}" Text="Fetching the host's campaign ledger…" />
                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="138" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RosterSearchBox" Grid.Column="0" Height="30" Margin="0,0,8,0"
                                     Padding="9,5" Background="#CC17120E" Foreground="{StaticResource Parchment}"
                                     BorderBrush="#66C9A24B" BorderThickness="1" FontFamily="{StaticResource Utility}"
                                     ToolTip="Search lords, clans, kingdoms, and cultures" />
                            <ComboBox x:Name="RosterScopePicker" Grid.Column="1" Style="{StaticResource WarComboBox}"
                                      Height="30" Margin="0,0,8,0" SelectedIndex="0" ToolTip="Filter by controller">
                                <ComboBoxItem Content="ALL LORDS" Tag="all" />
                                <ComboBoxItem Content="PLAYERS" Tag="player" />
                                <ComboBoxItem Content="AI LORDS" Tag="ai" />
                            </ComboBox>
                            <ComboBox x:Name="RosterStatusPicker" Grid.Column="2" Style="{StaticResource WarComboBox}"
                                      Height="30" Margin="0,0,8,0" SelectedIndex="0" ToolTip="Filter by current status">
                                <ComboBoxItem Content="ANY STATUS" Tag="all" />
                                <ComboBoxItem Content="ONLINE" Tag="online" />
                                <ComboBoxItem Content="ACTIVE" Tag="active" />
                                <ComboBoxItem Content="PRISONER" Tag="prisoner" />
                                <ComboBoxItem Content="WOUNDED" Tag="wounded" />
                            </ComboBox>
                            <ComboBox x:Name="RosterSortPicker" Grid.Column="3" Style="{StaticResource WarComboBox}"
                                      Height="30" Margin="0,0,8,0" SelectedIndex="0" ToolTip="Choose leaderboard ranking">
                                <ComboBoxItem Content="RENOWN" Tag="renown" />
                                <ComboBoxItem Content="GOLD" Tag="gold" />
                                <ComboBoxItem Content="INFLUENCE" Tag="influence" />
                                <ComboBoxItem Content="LEVEL" Tag="level" />
                                <ComboBoxItem Content="PARTY SIZE" Tag="party" />
                                <ComboBoxItem Content="FIEFS" Tag="fiefs" />
                            </ComboBox>
                            <Button x:Name="RosterRefreshButton" Grid.Column="4" Style="{StaticResource GhostButton}"
                                    Content="REFRESH" Height="30" ToolTip="Fetch the latest campaign ledger" />
                        </Grid>
                        <TextBlock x:Name="RosterDetailText" Grid.Row="3" Margin="0,0,0,8"
                                   FontFamily="{StaticResource Dispatch}" FontSize="10.5"
                                   Foreground="{StaticResource Steel}"
                                   Text="Select a lord to view culture, location, and clan tier." />
                        <DataGrid x:Name="RosterGrid" Grid.Row="4" IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" Background="#99140F0B"
                                  Foreground="{StaticResource Parchment}" BorderBrush="#55C9A24B"
                                  RowBackground="#44170F0C" AlternatingRowBackground="#66170F0C"
                                  HorizontalGridLinesBrush="#33C9A24B" FontSize="12">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource Leather}" />
                                    <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                    <Setter Property="BorderBrush" Value="#33C9A24B" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    <Setter Property="Padding" Value="6,5" />
                                    <Setter Property="FontFamily" Value="{StaticResource Dispatch}" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="28" />
                                <DataGridTextColumn Header="LORD" Binding="{Binding Name}" Width="105" />
                                <DataGridTextColumn Header="CTRL" Binding="{Binding Controller}" Width="52" />
                                <DataGridTextColumn Header="CLAN" Binding="{Binding Clan}" Width="80" />
                                <DataGridTextColumn Header="REALM" Binding="{Binding Kingdom}" Width="75" />
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="60" />
                                <DataGridTextColumn Header="ACTIVITY" Binding="{Binding CurrentAction}" Width="74" />
                                <DataGridTextColumn Header="LVL" Binding="{Binding Level}" Width="32" />
                                <DataGridTextColumn Header="GOLD" Binding="{Binding Gold, StringFormat=N0}" Width="50" />
                                <DataGridTextColumn Header="RENOWN" Binding="{Binding Renown, StringFormat=N0}" Width="59" />
                                <DataGridTextColumn Header="INF." Binding="{Binding Influence, StringFormat=N0}" Width="47" />
                                <DataGridTextColumn Header="PTY" Binding="{Binding PartySize}" Width="39" />
                                <DataGridTextColumn Header="F" Binding="{Binding Fiefs}" Width="35" />
                                <DataGridCheckBoxColumn Header="ON" Binding="{Binding Online, Mode=OneWay}" Width="30" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- ══ OPTIONS ══ -->
                    <Grid x:Name="OptionsPanel" Margin="330,34,60,34" MaxWidth="760"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="T H E   Q U A R T E R M A S T E R"
                                       FontSize="12" Foreground="{StaticResource Steel}" />
                            <TextBlock Text="Options"
                                       FontFamily="{StaticResource Display}" FontSize="34" FontWeight="Bold"
                                       Foreground="{StaticResource Parchment}" Margin="0,2,0,0" />
                            <Rectangle Height="1" Width="170" HorizontalAlignment="Left"
                                       Fill="{StaticResource Gold}" Opacity="0.55" Margin="0,10,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,4,12,0">

                                <!-- Game location -->
                                <TextBlock Style="{StaticResource SectionHeader}" Text="THE MUSTER GROUND" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="32" Background="{StaticResource Leather}"
                                            BorderBrush="#66C9A24B" BorderThickness="1" Padding="9,0">
                                        <TextBlock x:Name="GamePathText" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Dispatch}" FontSize="11.5"
                                                   Foreground="{StaticResource Parchment}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="Auto-detected from Steam" />
                                    </Border>
                                    <Button x:Name="BrowseGameButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0" Content="BROWSE&#x2026;"
                                            ToolTip="Pick the Bannerlord install folder (the one containing bin\Win64_Shipping_Client)" />
                                    <Button x:Name="RedetectGameButton" Grid.Column="2" Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0" Content="RE-DETECT"
                                            ToolTip="Forget the manual path and auto-detect from the Steam library again" />
                                </Grid>
                                <Grid Margin="0,0,0,22">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource OptionLabel}" Text="GAME VERSION" />
                                    <ComboBox x:Name="GameVersionPicker" Grid.Column="1" Height="30"
                                              Style="{StaticResource WarComboBox}" DisplayMemberPath="DisplayName"
                                              ToolTip="Select one of the Bannerlord installations found on this computer" />
                                    <TextBlock x:Name="RequiredGameVersionText" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                                               FontFamily="{StaticResource Dispatch}" FontSize="10.5"
                                               Foreground="{StaticResource Steel}" Text="Host requires Bannerlord 1.4.8" />
                                </Grid>

                                <!-- Update channels -->
                                <TextBlock Style="{StaticResource SectionHeader}" Text="THE ROYAL SCROLLS" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource OptionLabel}" Text="LAUNCHER" />
                                    <ToggleButton x:Name="LauncherChannelToggle" Grid.Column="1"
                                                  Style="{StaticResource ChannelToggle}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource OptionLabel}" Text="MOD SUITE" />
                                    <ToggleButton x:Name="SuiteChannelToggle" Grid.Column="4"
                                                  Style="{StaticResource ChannelToggle}" />
                                    <TextBlock Grid.Column="6" Style="{StaticResource OptionLabel}" Text="CO-OP CLIENT" />
                                    <ToggleButton x:Name="ClientChannelToggle" Grid.Column="7"
                                                  Style="{StaticResource ChannelToggle}" />
                                </Grid>
                                <TextBlock x:Name="NightlyWarning" Margin="0,0,0,22" FontSize="11"
                                           Foreground="{StaticResource BloodBright}" TextWrapping="Wrap"
                                           Visibility="Collapsed"
                                           Text="&#x26A0;  Nightly builds ride ahead of the host and can break joining. Switch back to stable if the muster refuses you." />

                                <!-- Password -->
                                <TextBlock Style="{StaticResource SectionHeader}" Text="THE WATCHWORD" />
                                <CheckBox x:Name="RememberPasswordCheck" Style="{StaticResource WarCheck}"
                                          Margin="0,0,0,22"
                                          Content="Remember the join password on this machine (encrypted for your Windows account)" />

                                <!-- Launch behavior + logs -->
                                <TextBlock Style="{StaticResource SectionHeader}" Text="THE CAMP" />
                                <CheckBox x:Name="CloseAfterLaunchCheck" Style="{StaticResource WarCheck}"
                                          Margin="0,0,0,10" IsChecked="True"
                                          Content="Close the launcher once Bannerlord has taken the field" />
                                <CheckBox x:Name="VerboseLoggingCheck" Style="{StaticResource WarCheck}"
                                          Margin="0,0,0,16"
                                          Content="Verbose launcher log (more detail for troubleshooting)" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="GatherLogsButton" Style="{StaticResource GhostButton}"
                                            Content="&#x2709;  EXPORT FULL LOG ZIP"
                                            ToolTip="Package full launcher and game logs locally for advanced diagnostics" />
                                    <Button x:Name="OpenLogsFolderButton" Style="{StaticResource GhostButton}"
                                            Margin="10,0,0,0" Content="OPEN LOG FOLDER" />
                                    <Button x:Name="GithubButton" Style="{StaticResource GhostButton}"
                                            Margin="10,0,0,0" Content="PROJECT ON GITHUB" />
                                    <Button x:Name="ReclaimSpaceButton" Style="{StaticResource GhostButton}"
                                            Margin="10,0,0,0" Content="RECLAIM DISK SPACE"
                                            ToolTip="Find module folders the co-op loadout no longer uses and offer to remove them" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="REPORT TO THE STEWARDS"
                                           Margin="0,10,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="30" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource OptionLabel}" Text="TYPE" Margin="0,0,0,4" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource OptionLabel}"
                                               Text="SHORT TITLE" Margin="8,0,0,4" />
                                    <ComboBox x:Name="ReportKindPicker" Grid.Row="1" Height="30" SelectedIndex="0"
                                              Style="{StaticResource WarComboBox}">
                                        <ComboBoxItem Content="BUG" Tag="bug" />
                                        <ComboBoxItem Content="FEATURE REQUEST" Tag="feature" />
                                    </ComboBox>
                                    <TextBox x:Name="ReportTitleText" Grid.Row="1" Grid.Column="1" Height="30" Margin="8,0,0,0"
                                             MaxLength="120" Background="{StaticResource Leather}"
                                             Foreground="{StaticResource Parchment}" BorderBrush="#66C9A24B"
                                             VerticalContentAlignment="Center" Padding="8,0"
                                             ToolTip="Short issue title" />
                                </Grid>
                                <TextBlock Style="{StaticResource OptionLabel}" Text="DETAILS, EXPECTED RESULT, AND REPRODUCTION STEPS"
                                           Margin="0,0,0,4" />
                                <TextBox x:Name="ReportDescriptionText" Height="70" MaxLength="4000"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Background="{StaticResource Leather}" Foreground="{StaticResource Parchment}"
                                         BorderBrush="#66C9A24B" Padding="8,6"
                                         ToolTip="What happened, what you expected, and how to reproduce it" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                    <CheckBox x:Name="AttachLogsCheck" Style="{StaticResource WarCheck}"
                                              IsChecked="True" Content="Attach a redacted excerpt of launcher and game logs" />
                                    <Button x:Name="AttachImagesButton" Style="{StaticResource GhostButton}"
                                            Margin="14,0,0,0" Content="ADD IMAGES"
                                            ToolTip="Add up to four PNG, JPEG, or WebP images (8 MB each)" />
                                    <Button x:Name="SubmitReportButton" Style="{StaticResource GhostButton}"
                                            Margin="14,0,0,0" Content="SEND REPORT" />
                                </StackPanel>
                                <TextBlock x:Name="ReportAttachmentsText" Margin="0,0,0,8"
                                           FontFamily="{StaticResource Dispatch}" FontSize="10.5"
                                           Foreground="{StaticResource Steel}"
                                           Text="No images or crash bundle selected." />
                                <TextBlock x:Name="OptionsStatusText" FontFamily="{StaticResource Dispatch}"
                                           FontSize="11" Foreground="{StaticResource Steel}"
                                           TextWrapping="Wrap" Text="" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
